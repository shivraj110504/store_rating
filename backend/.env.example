# Backend .env example
# Copy this file to `.env` and replace placeholder values before running the app.

# ----------------------
# Database configuration
# ----------------------
# Hostname or IP of the Postgres server
DB_HOST=localhost
# Port number for Postgres
DB_PORT=5432
# Database user
DB_USERNAME=postgres
# Database password
DB_PASSWORD=your_secure_password_here
# Database name
DB_NAME=store_rating_db

# JWT / Authentication
# Generate a strong secret
JWT_SECRET=replace_with_64_byte_hex_string
# Token lifetime
JWT_EXPIRES_IN=7d

# Server configuration
# Application port
PORT=3001
NODE_ENV=development
